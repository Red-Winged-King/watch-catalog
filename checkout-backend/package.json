{
  "name": "watch-catalog-ebay-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx db/migrate.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "fast-xml-parser": "5.11.2",
    "jose": "6.2.13",
    "mysql2": "3.24.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "22.18.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
